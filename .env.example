# Скопировать в .env и заполнить. .env в .gitignore — реальные значения в git не попадают.

# Токен от BotFather. Если утёк в git — отзывать через BotFather, а не переписывать историю.
BOT_TOKEN=
# Имя бота без @ — нужно для сборки инвайт-ссылок t.me/<bot>?start=inv_<code>
BOT_USERNAME=

DB_URL=jdbc:postgresql://localhost:5432/familytodo
DB_USER=familytodo
DB_PASSWORD=
